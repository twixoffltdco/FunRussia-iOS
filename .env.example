# ============================================================
# FUN RUSSIA iOS Connect — конфигурация окружения
# Скопируйте в .env.local (локально) или задайте у хостинга
# ============================================================

# URL Cloudflare Worker'а (DoH-эндпоинт). ОБЯЗАТЕЛЬНО https://
# Пример после деплоя worker.js: https://funrussia-doh.twixoff.workers.dev/dns-query
DOH_WORKER_URL=https://your-worker.your-subdomain.workers.dev/dns-query

# IP и порт игрового сервера FUN RUSSIA (SA-MP, UDP)
SERVER_IP=185.207.214.14
SERVER_PORT=7785

# Официальный домен Black Russia, который перехватывает воркер
TARGET_DOMAIN=play.blackrussia.online

# Ссылки на сайте
GITHUB_URL=https://github.com/fun-russia/ios-connect
TELEGRAM_URL=https://t.me/funrussia_support
TELEGRAM_CHAT_URL=https://t.me/funrussia_chat

# Базовое число для счётчика "Уже играют" (см. lib/players.ts)
BASE_PLAYERS=137
